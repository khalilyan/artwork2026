# API base URL (optional)
VITE_API_URL=http://localhost:4000/api

# Optional: image proxy endpoint for CDN-style resizing/compression.
# Example format expected by frontend utility:
#   GET <VITE_IMAGE_PROXY_BASE_URL>?url=<encoded-remote-image-url>&w=<width>&q=<quality>&output=<format>
# If omitted, frontend still optimizes known providers like Cloudinary and googleusercontent.
VITE_IMAGE_PROXY_BASE_URL=
